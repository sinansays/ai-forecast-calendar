{
  "name": "ai-forecast-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "npm test && npm run test:python && npm run check:modules && npm run validate:data && npm run clean && npm run build && npm run validate:ics",
    "test": "node --test",
    "test:python": "python -m unittest discover -s tests -v",
    "check:modules": "node scripts/check-modules.mjs",
    "validate:data": "node scripts/validate-canonical.mjs data/forecasts",
    "validate:ics": "node scripts/validate-ics.mjs dist/calendars",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
